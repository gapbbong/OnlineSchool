# 데이터베이스
# 로컬 개발: 기본값(SQLite) 그대로 사용
DATABASE_URL=sqlite+aiosqlite:///./online_school.db
# Supabase(Postgres) 연동 시 위 줄을 지우고 아래처럼 교체 (자세한 설명: ../SUPABASE_SETUP.md)
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 플랫폼 공용 클라이언트 ID
# (학교별로 별도 클라이언트를 쓰려면 SchoolSetting.google_client_id에 등록)
GOOGLE_CLIENT_ID=

# Google Sheets/Drive 비동기 동기화 워커
SYNC_WORKER_INTERVAL_SECONDS=15
SYNC_WORKER_BATCH_SIZE=20
SYNC_MAX_ATTEMPTS=5
